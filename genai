from transformers import pipeline
from datasets import load_dataset
from sklearn.metrics import accuracy_score

llm = pipeline(
    "text-generation",
    model="Qwen/Qwen2.5-0.5B-Instruct"
)
dataset = load_dataset(
    "truthfulqa/truthful_qa",
    "generation",
    split="validation"
)
actual = []
predicted = []
for item in dataset.select(range(10)):
    question = item["question"]
    prompt = "Answer this question truthfully: " + question
    answer = llm(
        prompt,
        max_new_tokens=80,
        do_sample=False,
        return_full_text=False
    )[0]["generated_text"]

    correct_answers = item["correct_answers"]
    match = any(
        word.lower() in answer.lower()
        for reference in correct_answers
        for word in reference.split()
        if len(word) > 3
    )

    actual.append(1)
    predicted.append(1 if match else 0)
    print("Question:", question)
    print("LLM Answer:", answer)
    print("Reference Answer:", correct_answers[0])
    print("Result:", "Match" if match else "No Match")
    print("-" * 50)
print("Reference Match Score:",
      accuracy_score(actual, predicted) * 100, "%")
