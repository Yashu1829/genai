import numpy as np
import faiss
import torch
from sentence_transformers import SentenceTransformer
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
documents = [
    "Bangalore to Goa flights take around 1 hour 20 minutes. Prices start from Rs.3500.",
    "Budget hotels in Goa cost Rs.1500 to Rs.3000 per night. Luxury hotels cost Rs.6000 or more.",
    "Popular attractions in Goa include Baga Beach, Calangute Beach, Fort Aguada, Dudhsagar Falls and Anjuna Beach.",
    "Baga Beach is famous for water sports and nightlife. Calangute Beach is popular for shopping and family holidays.",
    "Fort Aguada is a historic Portuguese fort with beautiful sea views.",
    "Dudhsagar Falls is famous for jeep tours and trekking routes.",
    "A three-day Goa itinerary includes Baga Beach, Fort Aguada, Calangute Beach and Dudhsagar Falls.",
    "November to February is the best time to visit Goa.",
    "Local transport includes taxis, scooters and buses. Scooter rentals cost Rs.300 to Rs.500 per day."
]

embedding_model = SentenceTransformer("sentence-transformers/all-MiniLM-L6-v2")
embeddings = embedding_model.encode(documents, convert_to_numpy=True)
index = faiss.IndexFlatL2(embeddings.shape[1])
index.add(embeddings.astype("float32"))
model_name = "google/flan-t5-small"
tokenizer = AutoTokenizer.from_pretrained(model_name)
model = AutoModelForSeq2SeqLM.from_pretrained(model_name)

device = "cuda" if torch.cuda.is_available() else "cpu"
model.to(device)
conversation_history = []
def retrieve_documents(query):
    query_embedding = embedding_model.encode([query])
    distances, indices = index.search(
        query_embedding.astype("float32"), 3
    )
    return [documents[i] for i in indices[0] if i >= 0]
def travel_assistant(user_query):

    history = ""
    for item in conversation_history[-6:]:
        history += item["role"] + ": " + item["content"] + "\n"

    search_query = history + user_query
    retrieved_docs = retrieve_documents(search_query)
    context = "\n".join(retrieved_docs)
    prompt = f"""
    You are a helpful travel assistant.
    Use the conversation history and retrieved information.

    History: {history}
    Information: {context}
    Question: {user_query}

    Give a short and helpful answer.
    Do not invent bookings or unavailable information.
    Answer:
    """
    inputs = tokenizer(
        prompt, return_tensors="pt",
        max_length=512, truncation=True
    ).to(device)
    outputs = model.generate(
        **inputs, max_new_tokens=120,
        num_beams=4
    )
    response = tokenizer.decode(
        outputs[0], skip_special_tokens=True
    )
    conversation_history.append({
        "role": "User", "content": user_query
    })
    conversation_history.append({
        "role": "Assistant", "content": response
    })
    return response, retrieved_docs
questions = [
    "I am planning a trip from Bangalore to Goa. How can I travel?",
    "What is the average flight duration?",
    "Suggest some budget hotels there.",
    "Which tourist attractions can I visit?",
    "Prepare a three-day itinerary for me."
]
print("===== TRAVEL ASSISTANT =====")
for question in questions:
    print("\nUser:", question)
    answer, retrieved = travel_assistant(question)
    print("Assistant:", answer)
print("\nYou can now chat with the Travel Assistant!")
print("Type 'exit' to stop.")
while True:
    user_input = input("\nYou: ")
    if user_input.lower() == "exit":
        print("Thank you for using the Travel Assistant!")
        break
    answer, retrieved = travel_assistant(user_input)
    print("Assistant:", answer)
