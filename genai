from datasets import load_dataset
from transformers import pipeline
from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score

# Load Dataset
data = load_dataset("mediabiasgroup/news-unfold-dataset")

# Load Pre-trained Transformer Model
classifier = pipeline(
    "text-classification",
    model="himel7/bias-detector"
)

# Select 20 Sentences
test_data = data["train"].select(range(20))

texts = list(test_data["text"])
actual_labels = list(test_data["label"])

# Predict Bias
results = classifier(texts, batch_size=16)

predicted_labels = [
    1 if r["label"] == "LABEL_1" else 0
    for r in results
]

# Display Results
for i, (text, actual, predicted, result) in enumerate(
    zip(texts, actual_labels, predicted_labels, results), 1
):
    print(f"\nSentence {i}: {text}")
    print("Actual:", "Biased" if actual == 1 else "Unbiased")
    print("Predicted:", "Biased" if predicted == 1 else "Unbiased")
    print(f"Confidence: {result['score'] * 100:.2f}%")
    print("Result:", "Correct" if actual == predicted else "Incorrect")

# Evaluation Metrics
print("\n===== EVALUATION METRICS =====")

print("Accuracy:", accuracy_score(actual_labels, predicted_labels) * 100)
print("Precision:", precision_score(actual_labels, predicted_labels, zero_division=0) * 100)
print("Recall:", recall_score(actual_labels, predicted_labels, zero_division=0) * 100)
print("F1-score:", f1_score(actual_labels, predicted_labels, zero_division=0) * 100)
